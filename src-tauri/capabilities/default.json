{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "allow-login",
    "allow-logout",
    "allow-restore-session",
    "allow-resume-session",
    "allow-import-browser-session",
    "allow-api-get",
    "allow-gradescope-get",
    "allow-cache-get",
    "allow-download-file",
    "allow-read-file",
    "allow-save-file",
    "allow-on-laptop-screen",
    "allow-saved-login-name",
    "allow-forget-login"
  ]
}
