{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ucla-login",
  "description": "Lets UCLA's sign-in page in a login window hand the typed login to the app, and nothing else.",
  "windows": [
    "login-canvas",
    "login-gradescope"
  ],
  "remote": {
    "urls": [
      "https://shb.ais.ucla.edu/*"
    ]
  },
  "permissions": [
    "allow-stash-login"
  ]
}
