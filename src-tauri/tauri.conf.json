{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvas",
  "version": "1.0.2",
  "identifier": "edu.ucla.canvasclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Canvas",
        "width": 1100,
        "height": 760,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NkU3MzRBNkY1MkY3RDMKUldUVDkxSnZTbk51WnI4T0RVR3VmTUZTMk5qdTdTQlRrNFB0Ym1mZDBCZGE4RlZwVTZCT1ZYYkMK",
      "endpoints": [
        "https://github.com/Chrisandyu/canvas/releases/latest/download/latest.json"
      ]
    }
  }
}
